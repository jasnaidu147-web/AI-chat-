# ==============================================================================
# Git Ignore Configuration for Gemini Chatbot Application
# ==============================================================================

# --------------------------------------------------
# Environment & Secret API Keys (CRITICAL)
# --------------------------------------------------
.env
.env.*
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Specific folder .env files
backend/.env
frontend/.env

# Do NOT ignore the example template files
!*.env.example
!backend/.env.example
!frontend/.env.example

# --------------------------------------------------
# Dependencies
# --------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
*/node_modules/
jspm_packages/

# --------------------------------------------------
# Logs & Debugging
# --------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --------------------------------------------------
# Production & Build Artifacts
# --------------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/

# --------------------------------------------------
# Operating System Files
# --------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# --------------------------------------------------
# Editor & IDE Directories
# --------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
.agents/

# --------------------------------------------------
# Temporary & Scratch Files
# --------------------------------------------------
tmp/
temp/
*.tmp
*.bak
preview.png
